// SpellCode Engine
import { codeMaps } from './spellCodeMaps';
import { encode as base64Encode } from 'js-base64';

const pad = (val, len) => String(val).padStart(len, '0');

export function encodeSpellToSpellCode(spell, stability, power, craftingDC) {
  const encoded =
    spell.level+
    codeMaps.school[spell.school] +
    spell.effects.map(e => codeMaps.effect[e] || 'NO').join('') +
    codeMaps.castingTime[spell.castingTime] +
    codeMaps.range[spell.range] +
    codeMaps.duration[spell.duration] +
    codeMaps.area[spell.area] +
    (spell.ritual ? '1' : '0') +
    (spell.concentration ? '1' : '0') +
    (spell.upcastable ? '1' : '0') +
    (spell.verbal ? 'V' : 'N') +
    (spell.somatic ? 'S' : 'N') +
    (spell.material ? 'M' : 'N') +
    pad(spell.materialCost || 0, 4) +
    codeMaps.materialType[spell.materialType] +
    codeMaps.attackSave[spell.attackSave] +
    (spell.damageSpell ? '1' : '0') +
    pad(spell.avgRoll || 0, 3) +
    pad(spell.targets || 0, 2) +
    (spell.hasRestriction ? '1' : '0') +
    pad(Math.round(stability * 100), 2) +
    pad(craftingDC || 0, 2) +
    pad(power, 3);
    (spell.classes || ["Wizard"]).map(c => codeMaps.classes[c] || "Z").join("");


  const meta =
    `${spell.name || "None"}#!#${spell.author || "None"}#!#${spell.materialText || "None"}#!#${spell.restrictionText || "None"}#!#${spell.description || "None"}#!#${spell.classes || "None"}`;

  return `${encoded}:${base64Encode(meta)}`;
}
