};

export function calculatePower(spell) {
  const {
    level,
    materialCost,
    materialType,
    material,
    ritual,
    verbal,
    somatic,
    material: hasMaterial,
    area,
    targets,
    hasRestriction,
    effects,
    range,
    duration,
    avgRoll,
    castingTime,
    attackSave,
    concentration,
    upcastable,
  } = spell;

  const basePower = BASE_POWER_BY_LEVEL[level] ?? 0;
  const numbericLevel = Number(level);

  // Material cost penalty
let materialPenalty = 0;
if (material && materialCost > 0) {
  let rawPenalty = 0;
  if (materialType === "Costed") {
    rawPenalty = materialCost / 2;
  } else if (materialType === "Consumed") {
    rawPenalty = materialCost;
  } else {
    rawPenalty = 0;
  }

  materialPenalty = Math.min(50, rawPenalty / 2);
}


  // Ritual bonus
  let ritualBonus = 0;
  if (ritual && numbericLevel >= 1 && numbericLevel < 7) {
    const nextLevelPower = BASE_POWER_BY_LEVEL[numbericLevel + 1] ?? 0;
    ritualBonus = nextLevelPower * 0.1;
  }

  // Component bonus
  if (!verbal && !somatic && !hasMaterial) return "Error: No components selected";
  const componentBonus =
    (verbal ? COMPONENT_BONUS.verbal : 0) +
    (somatic ? COMPONENT_BONUS.somatic : 0) +
    (hasMaterial ? COMPONENT_BONUS.material : 0);

  // Upcast bonus
  const upcastBonus = upcastable ? numbericLevel + 1 : 0;

  // Target modifier
  let targetBonus = 0;
  if (targets < 0) {
    targetBonus = BASE_POWER_BY_LEVEL[numbericLevel + 2] / (numbericLevel + 0.5);
  } else if (targets === 1) {
    targetBonus = 0;
  } else if (targets > 1) {
    targetBonus = (targets * basePower) / (numbericLevel * numbericLevel + 1);
  }

  // Restriction penalty
  const restrictionPenalty = hasRestriction ? basePower / 5 : 0;

  // Concentration penalty
  const concentrationPenalty = spell.concentration ? basePower / 4 : 0;

  // Linear value before multiplier
  const baseTotal =
    basePower -
    materialPenalty -
    concentrationPenalty +
    ritualBonus +
    componentBonus +
    upcastBonus +
    targetBonus -
    restrictionPenalty;

  // Multiplicative modifier sum
  const castMod = CASTING_MOD[castingTime] ?? 0;
  const rangeMod = RANGE_MOD[range] ?? 0;
  const durationMod = DURATION_MOD[duration] ?? 0;
  const saveMod = ATTACK_SAVE_MOD[attackSave] ?? 0;
  const areaMod = AREA_MOD[area] ?? 0;

  const multiplier = castMod + rangeMod + durationMod + saveMod + areaMod;

  // Effect bonus: (EffectPower * Level or 0.5 if Level 0)
  // Calculate total effect power with scaling multiplier

const effectLevel = level === 0 ? 0.5 : level;
const effectPowers = effects.map((e) => (EFFECT_POWER[e] ?? 0) * effectLevel);
const effectPowerTotal = effectPowers.reduce((sum, v) => sum + v, 0);

let effectMultiplier = 1;
const effectsUsed = effects.filter(e => e !== "None").length;
if (effectsUsed === 2) effectMultiplier = 0.7;
if (effectsUsed === 3) effectMultiplier = 0.5;

const scaledEffectBonus = effectPowerTotal * effectMultiplier;

  const rollBonus = Number(avgRoll) || 0;

  // Final Power
  const finalPower = Math.round(baseTotal * (1.5 + multiplier) + scaledEffectBonus + rollBonus);

  return finalPower;
}
