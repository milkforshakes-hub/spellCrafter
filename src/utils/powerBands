
// utils/powerBands.js

// Step 1: Power Band Threshold Calculations
export function getPowerBands(level) {
  const minPower = Math.round(6.32 + 13 * level + 0.163 * level * level);
  const avgDown = Math.round(10.47 + 20.27 * level + 0.741 * level * level);
  const avgUp = Math.round(16.87 + 32.9 * level + 0.977 * level * level);
  const maxPower = Math.round(25.5 + 50.9 * level + 0.871 * level * level);

  return { minPower, avgDown, avgUp, maxPower };
}

// Step 2: Power Evaluation Based on Calculated Bands
export function evaluatePower(level, power) {
  if (isNaN(power)) return "ERROR";

  const { minPower, avgDown, avgUp, maxPower } = getPowerBands(level);

  if (power < minPower) return "Underpowered";
  if (power < avgDown) return "Low Power";
  if (power < avgUp) return "Mid Power";
  if (power < maxPower) return "High Power";
  return "Overpowered";
}
