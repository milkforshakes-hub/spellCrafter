// utils/spellMath.js

import { getPowerBands } from './powerBands';

const SCHOOL_STABILITY_MODS = {
    "Abjuration": 5,
    "Conjuration": -5,
    "Divination": 0,
    "Enchantment": -3,
    "Evocation": -2,
    "Illusion": -6,
    "Necromancy": -4,
    "Transmutation": -1
  };

  const SCHOOL_DC_MODS = {
    "Abjuration": -1,
    "Conjuration": 1,
    "Divination": 2,
    "Enchantment": 1,
    "Evocation": 0,
    "Illusion": 2,
    "Necromancy": 1,
    "Transmutation": 0
  };  

export function formatDeviationAsPercent(deviation) {
    return `${Math.round(deviation * 100)}%`;
  }

  export function formatStabilityAsPercent(stability) {
    return `${Math.round(stability * 100)}%`;
  }
  
// Calculate deviation from expected power bands
export function getDeviation(level, power) {
  const { avgDown, avgUp } = getPowerBands(level);
  const midpoint = (avgDown + avgUp) / 2;
  const rawDeviation = (power - midpoint) / (avgUp - avgDown);

  let deviation = 0;
  if (rawDeviation < -0.5) {
    deviation = rawDeviation + 0.5;
  } else if (rawDeviation > 0.5) {
    deviation = rawDeviation - 0.5;
  }

  return Math.round(deviation * 100) / 100;
}

// Calculate spell stability based on inputs
export function getStability(spell, power, deviation) {
  console.log("🧮 STABILITY INPUTS →", { effects: spell.effects, power, deviation, spell });
  const fullCasters = new Set(["Wizard", "Cleric", "Druid", "Sorcerer", "Warlock", "Bard"]);
  const halfCasters = new Set(["Paladin", "Ranger", "Artificer"]);

// Change spell.classTags to spell.classes
  const classList = spell.classes || ["Wizard"];

  const fullCount = classList.filter(cls => fullCasters.has(cls)).length;
  const halfCount = classList.filter(cls => halfCasters.has(cls)).length;  
  
    let stability = 100;
  
    const [e1, e2, e3] = spell.effects.map(e => e?.trim() || "None");
    if (e1 !== "None" && e2 !== "None") stability -= 5;
    if (e3 !== "None") stability -= 5;
    if (spell.upcastable) stability -= 6;
    if (spell.area !== "None") stability -= 5;
    if (!spell.concentration) stability -= 4;
    if (spell.damageSpell) stability -= 5;
    if (spell.materialCost > 25) stability -= 5;
    if (spell.avgRoll > 0) stability -= 5;
    if (spell.level > 5) stability -= 5;
    if ([e1, e2, e3].includes("Control")) stability -= 5;
  
    // School modifier
    stability += SCHOOL_STABILITY_MODS[spell.school] || 0;
  
    const { avgDown, avgUp } = getPowerBands(spell.level);
    const avgPowerMid = (avgDown + avgUp) / 2;
  
    // Power deviation penalties
    stability -= spell.level / avgPowerMid;
    stability -= deviation * 25
    ;
    // Class Stability modifier
    stability -= (fullCount * fullCount + fullCount)+ (halfCount * halfCount - halfCount);
  
    // Power digit modification
    const lastDigit = power % 10;
    const secondLastDigit = Math.floor((power % 100) / 10);
    stability = stability - secondLastDigit + lastDigit;
  
    const finalStability =  Math.max(10, Math.min(99, Math.round(stability))) / 100;
    console.log("🧮 STABILITY OUTPUT →", finalStability);
  return finalStability;
  }

// Calculate crafting DC
export function getSpellCraftingDC(spell, stability, band) {
  console.log("🧮 DC INPUTS →", { spell, stability, band });
  const fullCasters = new Set(["Wizard", "Cleric", "Druid", "Sorcerer", "Warlock", "Bard"]);
  const halfCasters = new Set(["Paladin", "Ranger", "Artificer"]);

// Change spell.classTags to spell.classes
  const classList = spell.classes || ["Wizard"];

  const fullCount = classList.filter(cls => fullCasters.has(cls)).length;
  const halfCount = classList.filter(cls => halfCasters.has(cls)).length;  
  // Calculate base DC
    let dc = 10 + (spell.level / 2);

  const bandModifiers = {
    "Underpowered": -2,
    "Low Power": 0,
    "Mid Power": 2,
    "High Power": 3,
    "Overpowered": 6,
  };

  // Add band modifier
  dc += bandModifiers[band] ?? 0;

  // Add effects modifiers
  const [e1, e2, e3] = spell.effects;
  if (!["None", ""].includes(e2)) dc += 2;
  if (!["None", ""].includes(e3)) dc += 2;

  // Add area modifier
  if (spell.area !== "None") dc += 1;

  // Add upcastable modifier
  if (spell.upcastable) dc += 1;

  // Add restriction modifier
  if (spell.hasRestriction) dc -= 1;

  // Add concentration modifier
  if (spell.concentration) dc -= 1;

  // Add targets modifier
  if (spell.targets > 1 || spell.targets < 0) dc += 1;

  // Add material modifiers
  if (spell.materialType === "Consumed" || spell.materialCost >= 50) dc -= 3;

  // Add average roll modifier
  if (spell.avgRoll > 10) dc += 1;

  // Add ritual modifier
  if (spell.ritual) dc -= 1;

  // Add school modifier
  dc += SCHOOL_DC_MODS[spell.school] || 0;

  // Add class caster modifier
  const craftingDCModifier = Math.max(0, classList.length - 1);
  dc += craftingDCModifier;

  // Apply scaling factor
  const scale = (1 + (1 - stability)) * 0.85;
  dc = Number((dc * scale).toFixed(8));
  // Round and ensure minimum DC of 8
  const finalDC = Math.round(Math.max(8, dc));
  console.log("🧮 DC OUTPUT →", finalDC);
  return finalDC;
}
