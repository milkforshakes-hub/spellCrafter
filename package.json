{
  "name": "spell-crafter-polished",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A polished Spell Crafter web app with local dev, production server, and Docker support.",
  "scripts": {
    "dev": "node server/dev.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "official:convert": "node scripts/convert-official-spells.mjs",
    "homebrew:import": "node scripts/import-homebrew-spells.mjs",
    "generated:thilmorn": "node scripts/generate-thilmorn-spells.mjs",
    "corpus:analyze": "node scripts/analyze-spell-corpora.mjs",
    "llm:inspect": "python3 ml/scripts/inspect_corpus.py --config ml/config.json",
    "llm:prepare": "python3 ml/prepare_dataset.py --config ml/config.json",
    "llm:validate": "python3 ml/validate_dataset.py --config ml/config.json",
    "llm:sample": "python3 ml/scripts/sample_generation.py --config ml/config.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "express": "latest",
    "dotenv": "latest"
  },
  "devDependencies": {}
}
